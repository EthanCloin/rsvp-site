# Caddy site for come-see on base (Hostinger KVM). Tailnet-only for now.
#
# Caddy listens on localhost:8081 only, so nothing here is reachable from the
# internet. `tailscale serve` then publishes it on the tailnet with HTTPS
# (see ops/SETUP-base.md). To go public later, add a site block named
# come-see.ethancloin.xyz with the same body and point DNS at base; Caddy
# gets the certificate by itself.
#
# Install: append this file to /etc/caddy/Caddyfile, then
#   sudo caddy validate --config /etc/caddy/Caddyfile && sudo systemctl reload caddy
http://127.0.0.1:8081 {
	# The static site comes straight from the checkout, so a deploy (git pull)
	# updates it with no restart.
	root * /home/deploy/rsvp-site/static

	# events.json changes often; never let browsers cache a stale copy.
	header /events.json Cache-Control "no-cache"

	# Only /api/ goes to gunicorn, over the socket systemd creates for come-see.
	handle /api/* {
		reverse_proxy unix//run/come-see/gunicorn.sock
	}

	# Everything else is a file from the static folder.
	handle {
		file_server
	}
}
